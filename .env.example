# Copy to .env and set values for the deployment environment.
GEOGUARD_ALLOWED_ORIGINS=http://localhost:8051,http://127.0.0.1:8051
GEOGUARD_XGBOOST_DEVICE=cpu
# Optional absolute path for the local assessment audit database:
# GEOGUARD_DB_PATH=C:/path/to/assessments.sqlite3
# Optional absolute folder for survey assets and prepared terrain:
# GEOGUARD_TERRAIN_PATH=C:/path/to/terrain

# Optional AI-written explanations (server only; never prefix with VITE_).
OPENAI_API_KEY=
# Choose a Responses-compatible model enabled on your OpenAI API account.
OPENAI_MODEL=
